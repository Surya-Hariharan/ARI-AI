# ============================================================
# ARI System — Comprehensive Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit your actual .env file to version control.
# ============================================================

# ─── Firebase Authentication Framework ─────────────────────
# Firebase Admin SDK (Backend Gateway / Auth Service)
FIREBASE_PROJECT_ID=ari-voice-assistant
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@ari-voice-assistant.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"

# Firebase Client SDK (Frontend & Flutter App)
VITE_FIREBASE_API_KEY=AIzaSyDummyApiKeyForFirebase
VITE_FIREBASE_AUTH_DOMAIN=ari-voice-assistant.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ari-voice-assistant
VITE_FIREBASE_STORAGE_BUCKET=ari-voice-assistant.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ─── Resend Transactional Email Engine (OTP & Verification) ──
# Used for OTP/signup/password-reset emails (backend/gateway/auth_helpers.go SendEmail).
# RESEND_FROM_EMAIL's domain must be verified in your Resend account, or sends will fail —
# use the sandbox "onboarding@resend.dev" address for local testing without domain verification.
# If RESEND_API_KEY is unset/invalid, delivery falls back to SMTP_* (if configured), then to a
# console notice (recipient and subject only, never the body) in development. With ENV=production
# an unconfigured or failing provider is an error — OTP and reset bodies are account-takeover
# credentials and must never reach logs.
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz
RESEND_FROM_EMAIL=ARI Security <auth@ari.ai>

# ─── OAuth Providers (Google, GitHub) ───────────────
# Google OAuth2
GOOGLE_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-YourGoogleClientSecret

# GitHub OAuth2
GITHUB_CLIENT_ID=Iv1.YourGithubClientId
GITHUB_CLIENT_SECRET=YourGithubClientSecret

# ─── Supabase & PostgreSQL Infrastructure ──────────────────
# Pooled connection (Transaction Pooler - Recommended for production)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Direct connection (Session Mode)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Redis Cache & Task Queue Broker ───────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ─── Deployment Environment ────────────────────────────────
# "production" enables fail-closed behaviour: the gateway refuses to start without
# ALLOWED_ORIGINS, the agent refuses to start without ARI_SERVICE_TOKEN, and email
# delivery errors instead of falling back to a console notice.
ENV=development

# ─── Security & JWT Sessions ───────────────────────────────
# Required, must be a unique random value per deployment — never reuse this file's value.
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_YOUR_OWN_OUTPUT_OF_openssl_rand_-hex_32
JWT_EXPIRATION_HOURS=72

# Comma-separated list of browser origins allowed to call the gateway.
# REQUIRED in production — a wildcard lets any site drive this API from a victim's
# browser. Dev defaults to the Vite origins when unset.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public origin of the SPA. Used to build password-reset links, so it must be the
# address users actually reach — a wrong value produces links that go nowhere.
APP_BASE_URL=http://localhost:5173

# Shared secret authenticating gateway -> agent and execution -> agent calls.
# The agent exposes voiceprint enrollment/deletion, /execute, and RAG ingestion;
# without this it accepts all of that from any caller that can reach the port.
# REQUIRED in production. Generate with: openssl rand -hex 32
ARI_SERVICE_TOKEN=REPLACE_WITH_YOUR_OWN_OUTPUT_OF_openssl_rand_-hex_32

# Encrypts voiceprints at rest via pgcrypto (backend/gateway/voice_handlers.go).
# Biometric data — rotating this requires re-encrypting every enrolled embedding.
VOICE_EMBEDDING_KEY=REPLACE_WITH_YOUR_OWN_OUTPUT_OF_openssl_rand_-hex_32

# ─── Microservice Network Topology ──────────────────────────
GATEWAY_URL=http://localhost:8080
AGENT_URL=http://localhost:8000
EXECUTION_URL=http://localhost:8081

# ─── Voice Engine & Local AI Models ─────────────────────────
WHISPER_MODEL=base
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_S=20

# Cloud LLM fallback, used only when Ollama is unreachable (self-hosted-first: local by default).
# CLOUD_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
CLOUD_LLM_TIMEOUT_S=20

# Planner LLM decomposition timeout (complex/multi-step requests) and intent-classification
# LLM timeout (used when pattern/keyword classifiers come back low-confidence or unknown).
ARI_PLANNER_LLM_TIMEOUT_MS=8000
ARI_INTENT_LLM_TIMEOUT_MS=4000

# ─── Wake Word / Activation ─────────────────────────────────
# Backend priority is openWakeWord (self-hosted, no key) -> Porcupine (needs PICOVOICE_ACCESS_KEY)
# -> crude on-device fallback. Force one explicitly with ARI_WAKE_BACKEND if needed.
ARI_WAKE_WORDS=hey_jarvis
ARI_WAKE_BACKEND=auto
ARI_WAKE_SENSITIVITY=0.5
# PICOVOICE_ACCESS_KEY=

# Trigger command shortcuts (fast phrase->action matches like "stop"/"what time is it"),
# checked before the wake/intent pipeline. Defaults to backend/agent/trigger_commands.json.
# ARI_TRIGGER_COMMANDS_PATH=

# ─── Frontend Environment Exposure ──────────────────────────
VITE_GATEWAY_URL=http://localhost:8080
VITE_API_URL=http://localhost:8000/api/v1