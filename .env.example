# ============================================================
# ARI System — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit your actual .env to version control.
# ============================================================

# ─── Supabase PostgreSQL ─────────────────────────────────────
# Pooled connection (Transaction Pooler - Recommended)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Direct connection (Session mode - Alternative)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ─── Redis & Internal Services ──────────────────────────────
REDIS_ADDR=localhost:6379
AGENT_URL=http://localhost:8000

# ─── Authentication ─────────────────────────────────────────
# Secret key for signing JWT tokens (Generate: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-here

# ─── SMTP (Email for OTP Verification) ──────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=ARI System <your-email@gmail.com>

# ─── Frontend ───────────────────────────────────────────────
VITE_GATEWAY_URL=http://localhost:8080
