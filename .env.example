# ARI Backend Environment Configuration
# Copy this file to .env and fill in your values.

# ─── Security ──────────────────────────────────────────────
SECRET_KEY=change-this-to-a-strong-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SECRET_KEY_ROTATION_INTERVAL_HOURS=720

# Auth provider: "local" (built-in JWT) or "keycloak" (OIDC)
AUTH_PROVIDER=local

# ─── Keycloak (only if AUTH_PROVIDER=keycloak) ─────────────
KEYCLOAK_SERVER_URL=https://auth.example.com
KEYCLOAK_REALM=ari
KEYCLOAK_CLIENT_ID=ari-control-plane

# ─── Database ──────────────────────────────────────────────
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_DB=ari

# ─── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Groq Intelligence ────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Execution Agent ──────────────────────────────────────
AGENT_SIGNING_KEY=change-this-to-a-strong-random-key

# ─── CORS ──────────────────────────────────────────────────
# Comma-separated origins. Use "*" for dev only.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
