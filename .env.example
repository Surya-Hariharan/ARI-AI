# ARI Backend Environment Configuration (PRODUCTION TEMPLATE)
# Copy this to .env and fill in real values

# Security — CHANGE THIS (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-this-to-a-strong-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database — PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=ari

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Groq Intelligence
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
