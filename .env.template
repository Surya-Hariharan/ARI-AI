# ============================================================
# ARI System — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.template .env
#
# IMPORTANT: Never commit .env to version control.
# ============================================================

# ─── Database (Supabase PostgreSQL) ─────────────────────────
# Connection string for your Supabase Postgres instance
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# Supabase project URL and anon/public key (used by frontend & backend)
SUPABASE_URL=
SUPABASE_KEY=

# ─── Redis ──────────────────────────────────────────────────
REDIS_ADDR=redis:6379

# ─── Internal Services ──────────────────────────────────────
AGENT_URL=http://agent:8000

# ─── Authentication ─────────────────────────────────────────
# Secret key for signing JWT tokens — use a strong random string in production
# Generate one: openssl rand -hex 32
JWT_SECRET=

# ─── SMTP (Email) ───────────────────────────────────────────
# Gmail: host=smtp.gmail.com, port=587, use an App Password
# Other providers: Mailgun, SendGrid, Amazon SES, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ARI System <your-email@gmail.com>

# ─── Frontend ───────────────────────────────────────────────
# API gateway URL that the frontend connects to
# Local dev: http://localhost:8080
# Production: https://your-api-domain.com
VITE_GATEWAY_URL=http://localhost:8080
