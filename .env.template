# ==============================================================================
# ARI (Autonomous Responsive Intelligence) — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials and endpoints:
#   cp .env.template .env
#
# DO NOT commit '.env' containing real secrets to version control.
# ==============================================================================

# ─── Environment & Runtime ───────────────────────────────────────────────────
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=info

# ─── Microservice Network Topology ───────────────────────────────────────────
# Gateway Service (Go) - Entry point for HTTP/WebSocket clients
GATEWAY_PORT=8080
GATEWAY_URL=http://localhost:8080

# Agent Intelligence Service (Python / FastAPI) - Planning & Routing
AGENT_PORT=8000
AGENT_URL=http://localhost:8000

# Execution Service - Tool execution & sandboxed command runner
EXECUTION_PORT=8081
EXECUTION_URL=http://localhost:8081

# ─── Authentication & Security Tokens ─────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=your-64-byte-hex-jwt-secret-here-replace-with-openssl-generated-key
JWT_EXPIRATION_HOURS=72

# Session timeout in minutes for mobile & web clients
SESSION_TIMEOUT_MINUTES=15

# ─── Supabase PostgreSQL Database ────────────────────────────────────────────
# Transaction Pooler connection string (Recommended for Go / serverless)
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres

# Direct connection (Session mode, for migrations / direct SQL)
# DATABASE_DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-share

# ─── Redis & Distributed Task Queue ──────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Firebase Admin & Client Configuration ───────────────────────────────────
FIREBASE_PROJECT_ID=ari-voice-assistant
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@ari-voice-assistant.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# Client-facing Firebase keys (Web / Mobile)
VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=ari-voice-assistant.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ari-voice-assistant
VITE_FIREBASE_STORAGE_BUCKET=ari-voice-assistant.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:your-app-id-here

# ─── Transactional Email & Verification (Resend) ─────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=ARI Security <auth@yourdomain.com>

# ─── SMTP Fallback (e.g. Gmail App Password) ─────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=ARI System <your-email@gmail.com>

# ─── OAuth Identity Providers ────────────────────────────────────────────────
# Google Cloud Console OAuth 2.0 Client
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# GitHub OAuth App
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Apple Sign In
APPLE_CLIENT_ID=com.ari.voice.assistant.auth
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id

# ─── Voice Engine & Local Neural Models ──────────────────────────────────────
# Whisper STT model type: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Ollama local model hosting endpoint (e.g. llama3, qwen2.5)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:32b

# Optional external LLM API fallback (Air-gapped by default)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Mobile Client Exposure (Android / Companion) ────────────────────────────
# The endpoint your Android phone connects to over the local network (mTLS mesh)
ARI_MOBILE_GATEWAY_URL=http://192.168.1.100:8080
ARI_MOBILE_WS_URL=ws://192.168.1.100:8080/ws/audio

# Web Client environment exposure
VITE_GATEWAY_URL=http://localhost:8080
VITE_API_URL=http://localhost:8000/api/v1
