*.sketch
*.psd
*.ai
*.xd
*.drawio
*.canvas
*.excalidraw
design/
designs/
mockups/
**/figma/
**/designs/
**/mockups/
frontend/public/auth-bg.png
frontend/public/image/

# ─── Node & Dependencies ────────────────────────────────────
node_modules/
**/node_modules/
package-lock.json.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Build & Bundler Outputs ────────────────────────────────
dist/
**/dist/
build/
**/build/
.vite/
**/.vite/
out/
.next/

# ─── Python Caches & Virtual Envs ───────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# ─── Go Binaries & Temp Files ───────────────────────────────
*.exe
*.exe~
*.dll
*.dylib
tmp/
**/tmp/
temp/
**/temp/
# `go build` names its output after the package directory, so the gateway and
# execution worker both produce a binary called `main`. These are anchored to
# those two directories on purpose: a bare `main` pattern matches *any* path
# segment with that name, which silently excluded every `src/main/` source
# directory in android/.
/backend/gateway/main
/backend/execution/main
*.test
*.out

# ─── Logs & Runtime Artifacts ───────────────────────────────
*.log
execution_logs.txt
gateway_logs.txt
agent_logs.txt
logs/

# ─── IDEs, Editors & AI Assistants ──────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
.DS_Store
Thumbs.db
.gemini/
.agents/
.agent/
.claude/
.cursor/
.windsurf/

# ─── Test & Demo Artifacts ──────────────────────────────────
**/test_*.py
**/*_test.py
**/*_test.go
**/*demo*.py
**/*.spec.*
**/*.test.*

# ─── Docker Overrides ───────────────────────────────────────
docker-compose.override.yml
docker-compose.local.yml
