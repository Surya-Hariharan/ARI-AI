# ============================================================
# ARI System — Git Ignore Configuration
# Protects internal files, credentials, logs, builds & caches
# ============================================================

# ─── Environment & Secrets ──────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
*.p12
*.secret
credentials.json
service-account*.json
id_rsa
id_ed25519

# ─── Supabase & Database ─────────────────────────────────────
.supabase/
supabase/.temp/
supabase/.branches/
supabase/.env
*.db
*.sqlite
*.sqlite3

# ─── Node & Dependencies ────────────────────────────────────
node_modules/
**/node_modules/
package-lock.json.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Build & Bundler Outputs ────────────────────────────────
dist/
**/dist/
build/
**/build/
.vite/
**/.vite/
out/
.next/

# ─── Python Caches & Virtual Envs ───────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
model_cache/
**/model_cache/

# ─── Go Binaries & Temp Files ───────────────────────────────
*.exe
*.exe~
*.dll
*.dylib
tmp/
**/tmp/
temp/
**/temp/
main
*.test
*.out

# ─── Logs & Runtime Artifacts ───────────────────────────────
*.log
execution_logs.txt
gateway_logs.txt
logs/

# ─── IDEs, Editors & AI Assistants ──────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
.DS_Store
Thumbs.db
.gemini/
.agents/
.agent/
.claude/
.cursor/

# ─── Test & Demo Artifacts ──────────────────────────────────
**/test_*.py
**/*_test.py
**/*_test.go
**/*demo*.py
**/*.spec.*
**/*.test.*

# ─── Docker Overrides ───────────────────────────────────────
docker-compose.override.yml
docker-compose.local.yml

# ─── Internal Media & Assets ────────────────────────────────
frontend/public/auth-bg.png
frontend/public/image/
