# ============================================================
# ARI System — Comprehensive Git Ignore Configuration
# Protects internal files, design assets, backend models & secrets
# ============================================================

# ─── Environment & Secrets ──────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
*.p12
*.secret
credentials.json
service-account*.json
id_rsa
id_ed25519

# ─── Supabase & Internal Databases ───────────────────────────
.supabase/
supabase/.temp/
supabase/.branches/
supabase/.env
*.db
*.sqlite
*.sqlite3
voiceprints.db
**/voiceprints.db

# ─── Backend Models & Heavy ML Checkpoints ─────────────────
model_cache/
**/model_cache/
*.ckpt
*.pt
*.pth
*.onnx
*.bin
*.safetensors
*.engine
*.h5

