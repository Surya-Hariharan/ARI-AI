{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionLog",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "task_id": { "type": "string" },
    "device_id": { "type": "string" },
    "status": { "type": "string", "enum": ["listening", "planning", "executing", "completed", "failed"] },
    "metadata": { "type": "object" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "task_id", "device_id", "status"]
}
